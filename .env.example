# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*

# Client Application URL (used for reset links generated in emails)
APP_URL=http://localhost:5173

# Client API URL (leave empty in dev when using Vite proxy)
VITE_API_URL=

# SMTP Email Configuration (Nodemailer)
# Example providers: Brevo (ex-Sendinblue), Gmail, Mailgun, Infomaniak, Hostinger, AWS SES...
# If SMTP_HOST or SMTP_USER is not provided, dev mode generates direct reset link in server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Relancio" <noreply@relancio.com>
